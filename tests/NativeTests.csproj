<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <OutputType>Exe</OutputType>
    <AssemblyName>UnitTests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <Optimize>true</Optimize>
    <ExcludedPerformanceCases Condition="'$(ExcludePerformanceRedesignScenarios)' == 'true'">scenarios\cases\npc\PerformanceRedesignScenario.cs;scenarios\cases\world\AdaptiveSimulationScenario.cs</ExcludedPerformanceCases>
    <ExcludedAdaptiveCases Condition="'$(ExcludeAdaptiveScenarios)' == 'true'">scenarios\cases\world\AdaptiveSimulationScenario.cs</ExcludedAdaptiveCases>
    <DefineConstants>NATIVE_TESTS</DefineConstants>
    <OutputPath Condition="'$(OutputPath)' == ''">bin\Release\</OutputPath>
    <GameAssembly Condition="'$(GameAssembly)' == ''">..\WRogue\bin\Release\RogueSurvivor.exe</GameAssembly>
    <ExcludedFollowerTravelCases Condition="'$(ExcludeFollowerTravelScenarios)' == 'true'">scenarios\cases\npc\FollowerTravel*.cs;scenarios\cases\world\FollowerTravel*.cs</ExcludedFollowerTravelCases>
    <ExcludedCommunityCases Condition="'$(ExcludeCommunityScenarios)' == 'true'">scenarios\cases\npc\Community*.cs;scenarios\cases\world\Community*.cs;scenarios\cases\npc\FollowerCallScenario.cs;scenarios\cases\npc\FollowerTravel*.cs;scenarios\cases\world\FollowerTravel*.cs;scenarios\cases\npc\Scavenging*.cs;scenarios\cases\world\Scavenging*.cs</ExcludedCommunityCases>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
    <Reference Include="RogueSurvivor"><HintPath>$(GameAssembly)</HintPath><Private>true</Private></Reference>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**;$(ExcludedCommunityCases);$(ExcludedFollowerTravelCases);$(ExcludedPerformanceCases);$(ExcludedAdaptiveCases)" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
